# Server Port
PORT=5001

# Node Environment
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hotelpro?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=hotelpro_super_secure_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Payment Gateway Configuration (sandbox, razorpay, or stripe)
PAYMENT_PROVIDER=sandbox
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
STRIPE_SECRET_KEY=sk_test_placeholder_secret

# Transactional Email Configuration (Optional SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=placeholder_smtp_user
SMTP_PASS=placeholder_smtp_pass
EMAIL_FROM="HotelPro Support <support@hotelpro.com>"

# Initial Administrator Seed Configuration (NEVER committed to git)
ADMIN_NAME=HotelPro Master Admin
ADMIN_EMAIL=admin@hotelpro.com
ADMIN_PASSWORD=Admin@HotelPro2026
ADMIN_PHONE=+1 (800) 555-0199
